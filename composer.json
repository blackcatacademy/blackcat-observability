{
    "name": "blackcat/observability",
    "description": "Observability manager (metrics, events, tracing) for the BlackCat platform.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "BlackCat\\Observability\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlackCat\\Observability\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
